# Copy this file to env/.env.<environment> (e.g. env/.env.dev) and fill in the values.
# Choose the environment with TEST_ENV (default: dev). In Azure Pipelines, use a variable group instead.
# Variable NAMES come from projects/<project>/project.config.ts.

# ---- prj-a -------------------------------------------------------------
PRJA_V1_URL=https://old-host.example.internal
PRJA_V2_URL=https://new-host.example.internal

# Only if prj-a uses auth type "bearer"
# PRJA_V1_TOKEN=
# PRJA_V2_TOKEN=

# Only if prj-a uses auth type "azureAd" (client credentials)
# PRJA_V1_SCOPE=api://<v1-app-id>/.default
# PRJA_V2_SCOPE=api://<v2-app-id>/.default
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- framework settings (optional) -------------------------------------
# REQUEST_TIMEOUT_MS=30000
# IGNORE_HTTPS_ERRORS=false
